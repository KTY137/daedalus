{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daedalus",
  "version": "0.1.0",
  "identifier": "dev.daedalus.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "http://127.0.0.1:8765"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": {
      "backend/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first Daedalus agent operating system",
    "longDescription": "Daedalus desktop packages the existing local Trust Kernel, Ikarus cockpit and Web API in a native Tauri shell without introducing a second control plane."
  }
}
