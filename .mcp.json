{
  "mcpServers": {
    "serena": {
      "command": "C:/Users/nukei/.local/bin/serena.exe",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "c:/Users/nukei/Desktop/agent_env"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    }
  }
}
