# daedalus — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored (holds your private keys); THIS template is committed so
# a fresh clone knows which variables exist.
#
# As of 2026-07-29 `daedalus/dotenv.py` LOADS `.env` automatically at CLI start
# (before the budget guard), so you no longer need to export these by hand or
# source the file yourself. Two rules to know:
#   - a REAL exported environment variable always wins; `.env` only fills gaps
#     it never overrides something you already exported in your shell.
#   - a `.env` that is TRACKED BY GIT is refused loudly rather than loaded --
#     `git add -f .env` is a leak in progress, and the loader will not make it
#     convenient. Run `git rm --cached .env` and rotate any key that was in it.
# Manual export/sourcing still works exactly as before if you prefer it; the
# loader only fills what the process environment did not already set.

# ---- Local bench (Ollama) — no secrets, safe defaults ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Exact operator consent for a remote Ollama endpoint, for example
# 100.119.126.9:11434. This does not classify the endpoint as trusted.
DAEDALUS_OLLAMA_REMOTE_OK=

# ---- DeepSeek (external "free-ish" lane; stays DORMANT unless a key is set) ----
# Leaving DEEPSEEK_API_KEY empty keeps the external bench off (local-first posture).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Optional frontier provider keys (providers declared but not yet wired) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Spend ceiling for one activation period, in USD. The process guard refuses
# vendor spawns past it. Loaded by cli.main BEFORE the guard installs, which
# is why it may live here. Empty = module defaults.
DAEDALUS_BUDGET_USD=
DAEDALUS_BUDGET_MAX_CALLS=
