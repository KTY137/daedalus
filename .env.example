# daedalus — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored (holds your private keys); THIS template is committed so
# a fresh clone knows which variables exist.
#
# As of 2026-07-29 `daedalus/dotenv.py` LOADS `.env` automatically at CLI start
# (before the budget guard), so you no longer need to export these by hand or
# source the file yourself. Two rules to know:
#   - a REAL exported environment variable always wins; `.env` only fills gaps
#     it never overrides something you already exported in your shell.
#   - a `.env` that is TRACKED BY GIT is refused loudly rather than loaded --
#     `git add -f .env` is a leak in progress, and the loader will not make it
#     convenient. Run `git rm --cached .env` and rotate any key that was in it.
# Manual export/sourcing still works exactly as before if you prefer it; the
# loader only fills what the process environment did not already set.

# ---- Local bench (Ollama) — no secrets, safe defaults ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Exact operator consent for a remote Ollama endpoint, for example
# 100.119.126.9:11434. This does not classify the endpoint as trusted.
DAEDALUS_OLLAMA_REMOTE_OK=

# ---- DeepSeek (external "free-ish" lane; stays DORMANT unless a key is set) ----
# Leaving DEEPSEEK_API_KEY empty keeps the external bench off (local-first posture).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Optional frontier provider keys (providers declared but not yet wired) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Budget and execution limits (kernel policy) ----
#
# DAEDALUS_BUDGET_USD — spend ceiling (period USD). The process guard refuses
#   vendor spawns past it. Default: $5.00 per day. Widening execution limits is
#   the owner's decision; ledger keeps recording all usage and evidence.
#   Example:
#   # DAEDALUS_BUDGET_USD=25.00
#
# DAEDALUS_BUDGET_MAX_CALLS — billable call ceiling (e.g., LLM inference calls).
#   Counts known-cost vendors; free/local calls do not count. Default: 40.
#   Example:
#   # DAEDALUS_BUDGET_MAX_CALLS=100
#
# DAEDALUS_EXECUTION_LIMIT_POLICY — canonical JSON execution limit policy.
#   Modes: "bounded" (all caps on), "custom" (toggle individual axes),
#   "unbounded_execution" (all caps off). Default: "bounded" (enforces all 8
#   axes: period_usd, billable_calls, mission_spend, tokens, wall_time,
#   attempts, concurrency, work_scope). Disabled caps use enforcement flags,
#   never big numbers. Kill switch, egress, write roots, promotion remain.
#   Example (disable period USD and call caps, keep others):
#   # DAEDALUS_EXECUTION_LIMIT_POLICY={"configured":{"attempts":true,"billable_calls":false,"concurrency":true,"mission_spend":false,"period_usd":false,"tokens":false,"wall_time":true,"work_scope":true},"mode":"custom"}
#
# DAEDALUS_BUDGET_ON_UNKNOWN — policy for unknown vendor prices: "worst_case"
#   (default: charge $5.00) or "refuse" (fail closed). Default: worst_case.
#   Example:
#   # DAEDALUS_BUDGET_ON_UNKNOWN=refuse
#
# DAEDALUS_SUBSCRIPTION_VENDORS — comma-separated vendor names with flat-rate
#   subscriptions (charged $0 but still counted against call cap). Default: empty.
#   Only names known to the pricing table count (anthropic_cli, openai_cli,
#   google_agy, anthropic_api, openai_api, google_api, deepseek); others are
#   ignored silently. Example (Codex CLI signed in with a ChatGPT plan):
#   # DAEDALUS_SUBSCRIPTION_VENDORS=openai_cli
#
# DAEDALUS_BUDGET_LEDGER — path to budget ledger JSON file. Default: runs/budget/ledger.json.
#   Example:
#   # DAEDALUS_BUDGET_LEDGER=/path/to/ledger.json
#
# DAEDALUS_BUDGET_PERIOD — "day" (reset ceiling daily) or "total" (cumulative).
#   Default: day. Example:
#   # DAEDALUS_BUDGET_PERIOD=total

DAEDALUS_BUDGET_USD=
DAEDALUS_BUDGET_MAX_CALLS=
