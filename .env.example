# daedalus — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored (holds your private keys); THIS template is committed so
# a fresh clone knows which variables exist. The harness reads these from the
# process environment, so export them / source `.env` in your shell (or let the
# VS Code integration load it) before running the bench.

# ---- Local bench (Ollama) — no secrets, safe defaults ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- DeepSeek (external "free-ish" lane; stays DORMANT unless a key is set) ----
# Leaving DEEPSEEK_API_KEY empty keeps the external bench off (local-first posture).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Optional frontier provider keys (providers declared but not yet wired) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
