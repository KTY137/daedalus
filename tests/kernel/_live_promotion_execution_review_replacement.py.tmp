from __future__ import annotations

import ast
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
PUBLIC = ROOT / "daedalus" / "kairos" / "gated_writes.py"
RETAINED = ROOT / "daedalus" / "kairos" / "_gated_writes_execution_accounting.py.src"
MANAGER_BOUNDARY = ROOT / "daedalus" / "kairos" / "promotion_manager_boundary.py"
REPLAY_BOUNDARY = ROOT / "daedalus" / "kairos" / "promotion_manager_replay.py"


def _source(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def _tree(path: Path) -> ast.Module:
    return ast.parse(_source(path), filename=str(path))


def _function(path: Path, name: str) -> ast.FunctionDef:
    for node in _tree(path).body:
        if isinstance(node, ast.FunctionDef) and node.name == name:
            return node
    raise AssertionError(f"missing function {name}")


def _segment(path: Path, node: ast.AST) -> str:
    value = ast.get_source_segment(_source(path), node)
    assert value is not None
    return value


def test_public_compatibility_loader_retains_exact_accounted_boundary() -> None:
    public = _source(PUBLIC)
    assert "_gated_writes_execution_accounting.py.src" in public
    assert "_EXPECTED_GIT_BLOB_SHA" in public
    assert "_git_blob_sha(_payload)" in public
    assert "exec(" in public
    assert "install_promotion_manager_boundary(globals())" in public
    assert "install_promotion_manager_replay_boundary(globals())" in public
    assert public.index("exec(") < public.index(
        "install_promotion_manager_boundary(globals())"
    )


def test_retained_boundary_starts_accounting_before_manager_mutation() -> None:
    source = _source(RETAINED)
    promote = _segment(RETAINED, _function(RETAINED, "promote_candidates"))
    assert "PromotionExecutionLedger" in promote
    assert ".begin(" in promote
    assert "GitWorktreeManager" in promote
    assert promote.index(".begin(") < promote.index("GitWorktreeManager")
    assert "primary_checkout_before_sha256" in promote
    assert "mutation_entered" in promote
    assert "pending_reconciliation" in promote
    assert "authorization" in promote
    assert "promotion_event_store" in promote
    assert "PromotionExecutionLedger" in source


def test_retained_boundary_terminalizes_through_execution_ledger() -> None:
    promote = _segment(RETAINED, _function(RETAINED, "promote_candidates"))
    assert ".complete(" in promote
    assert "primary_checkout_after_sha256" in promote
    assert "integration_branch" in promote
    assert "integration_revision" in promote
    assert "_promotion_failure_report" in promote
    assert "receipt_id" in promote


def test_retained_boundary_does_not_issue_owner_authority() -> None:
    source = _source(RETAINED).lower()
    assert "issue_owner_approval" not in source
    assert "merge_pull_request" not in source
    assert "closed=true" not in source
    assert "gate 0 is closed" not in source


def test_manager_and_replay_layers_wrap_only_retained_seams() -> None:
    manager = _source(MANAGER_BOUNDARY)
    replay = _source(REPLAY_BOUNDARY)
    assert 'namespace["GitWorktreeManager"] = state.manager_factory' in manager
    assert 'namespace["PromotionExecutionLedger"] = state.ledger_factory' in manager
    assert 'namespace["promote_candidates"] = state.promote_candidates' in manager
    assert "state.ledger_constructor(*args, **kwargs)" in replay
    assert 'namespace["PromotionExecutionLedger"] = factory' in replay
    for source in (manager.lower(), replay.lower()):
        assert "issue_owner_approval" not in source
        assert "merge_pull_request" not in source
        assert "git worktree" not in source


def test_post_mutation_unknown_identity_remains_pending() -> None:
    manager = _source(MANAGER_BOUNDARY)
    replay = _source(REPLAY_BOUNDARY)
    assert "PromotionManagerAuditPending" in manager
    assert "cannot prove the surviving integration identity" in manager
    assert "PromotionManagerAuditPending" in replay
    assert "manager fault branch revision cannot be proven" in replay
    assert "replace(result, execute=False, completion=None)" in replay
