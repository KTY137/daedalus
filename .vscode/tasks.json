{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Daedalus Bridge: watch",
      "detail": "Background watcher: processes outbox/*.json into inbox/*.report.json (see docs/COMMS_PROTOCOL.md)",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.file_bridge", "watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "agent-bridge",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(ERROR|Traceback)(.*)$",
            "file": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^AGENT_BRIDGE_START$",
          "endsPattern": "^AGENT_BRIDGE_READY$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Daedalus: doctor",
      "detail": "Is the bench ready? (Ollama / model / claude CLI)",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.cli", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus: status",
      "detail": "Local bridge status for a registered project",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.cli", "status", "--project", "${input:project}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus: list projects",
      "detail": "Show registered projects from projects/*.json",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.cli", "projects"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus Bridge: watch project",
      "detail": "Background watcher with a registered project as the default repo",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.file_bridge", "watch", "--project", "${input:project}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "agent-bridge-project",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(ERROR|Traceback)(.*)$",
            "file": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^AGENT_BRIDGE_START$",
          "endsPattern": "^AGENT_BRIDGE_READY$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Daedalus Team: enqueue local-only",
      "detail": "Queue a task for the local bench only; never calls Claude",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "daedalus.file_bridge",
        "enqueue",
        "${input:objective}",
        "--project",
        "${input:project}",
        "--lane",
        "local_only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus Team: enqueue auto",
      "detail": "Queue a task for the router; may fall back to Claude",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "daedalus.file_bridge",
        "enqueue",
        "${input:objective}",
        "--project",
        "${input:project}",
        "--lane",
        "auto"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus: benchmark (dry)",
      "detail": "Projected token/cost picture; no live calls",
      "type": "process",
      "command": "python",
      "args": ["-m", "daedalus.cli", "benchmark"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus: spawn (prompt for objective)",
      "detail": "Decompose an objective and plan the local bench dispatch",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "daedalus.cli",
        "spawn",
        "${input:objective}",
        "--project",
        "${input:project}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Daedalus: run tests",
      "detail": "python -m unittest discover tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest", "discover", "tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "objective",
      "type": "promptString",
      "description": "Objective to decompose onto the local bench"
    },
    {
      "id": "project",
      "type": "promptString",
      "description": "Registered project name from projects/*.json",
      "default": "project_tct"
    }
  ]
}
