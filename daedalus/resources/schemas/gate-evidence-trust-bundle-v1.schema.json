{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/gate-evidence-trust-bundle-v1.schema.json",
  "title": "EvidenceTrustBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "bundle_id",
    "collector_id",
    "collector_key_id",
    "index_sha256",
    "source_revision",
    "source_tree_revision",
    "requirements_sha256",
    "iron_plan_sha256",
    "registry_sha256",
    "workflow_anchors",
    "artifact_evidence_sha256s",
    "runtime_envelope_sha256s",
    "fault_matrix_sha256s",
    "review_evidence_sha256s",
    "owner_verifier_sha256s",
    "issued_at",
    "expires_at",
    "signature_sha256",
    "provenance"
  ],
  "properties": {
    "contract_type": {
      "const": "daedalus-gate-evidence-trust-bundle/1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "$ref": "#/$defs/id"
    },
    "collector_id": {
      "$ref": "#/$defs/id"
    },
    "collector_key_id": {
      "$ref": "#/$defs/id"
    },
    "index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_revision": {
      "$ref": "#/$defs/revision"
    },
    "source_tree_revision": {
      "$ref": "#/$defs/revision"
    },
    "requirements_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "iron_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workflow_anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/workflowAnchor"
      }
    },
    "artifact_evidence_sha256s": {
      "$ref": "#/$defs/digestArray"
    },
    "runtime_envelope_sha256s": {
      "$ref": "#/$defs/digestArray"
    },
    "fault_matrix_sha256s": {
      "$ref": "#/$defs/digestArray"
    },
    "review_evidence_sha256s": {
      "$ref": "#/$defs/digestArray"
    },
    "owner_verifier_sha256s": {
      "$ref": "#/$defs/digestArray"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digestArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "workflowAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "repository_path",
        "workflow_evidence_sha256",
        "definition_sha256"
      ],
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/id"
        },
        "repository_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/.+\\.(?:yml|yaml)$"
        },
        "workflow_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_revision",
        "created_at",
        "input_digests",
        "trace_id"
      ],
      "properties": {
        "origin": {
          "const": "gates.evidence-trust-bundle"
        },
        "source_revision": {
          "$ref": "#/$defs/revision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_digests": {
          "$ref": "#/$defs/digestArray"
        },
        "trace_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
