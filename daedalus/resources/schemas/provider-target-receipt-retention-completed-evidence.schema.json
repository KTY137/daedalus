{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/provider-target-receipt-retention-completed-evidence.schema.json",
  "title": "Provider Target Receipt Retention Completed Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    }
  },
  "properties": {
    "schema": {
      "const": "daedalus-provider-target-receipt-retention-completed-evidence/1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "admission_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "recovery_decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_target_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retention_intent_id": {
      "type": "integer",
      "minimum": 1
    },
    "retention_intent_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retention_event_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "retention_topology_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "receipt_artifact_file_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "start_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "terminal_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "event_store_path": {
      "$ref": "#/$defs/boundedPath"
    },
    "receipt_cas_path": {
      "$ref": "#/$defs/boundedPath"
    },
    "admission_identity_bound": {
      "const": true
    },
    "admission_topology_bound": {
      "const": true
    },
    "recovery_decision_bound": {
      "const": true
    },
    "provider_target_receipt_authenticated": {
      "const": true
    },
    "retention_intent_completed": {
      "const": true
    },
    "retained_receipt_cas_verified": {
      "const": true
    },
    "primary_checkout_disjointness_verified": {
      "const": true
    },
    "retention_topology_stable": {
      "const": true
    },
    "receipt_artifact_identity_stable": {
      "const": true
    },
    "persisted_effect_terminal_verified": {
      "const": false
    },
    "automatic_reexecution_allowed": {
      "const": false
    },
    "effect_start_authorized": {
      "const": false
    },
    "retention_write_authorized": {
      "const": false
    },
    "effect_terminalization_authorized": {
      "const": false
    },
    "canonical_entrypoint_registered": {
      "const": false
    },
    "gate_transition_authorized": {
      "const": false
    },
    "closed": {
      "const": false
    }
  },
  "required": [
    "schema",
    "source_revision",
    "admission_sha256",
    "recovery_decision_sha256",
    "provider_target_receipt_sha256",
    "target_projection_sha256",
    "receipt_artifact_sha256",
    "retention_intent_id",
    "retention_intent_payload_sha256",
    "retention_event_evidence_sha256",
    "retention_topology_identity_sha256",
    "receipt_artifact_file_identity_sha256",
    "start_receipt_sha256",
    "terminal_receipt_sha256",
    "event_store_path",
    "receipt_cas_path",
    "admission_identity_bound",
    "admission_topology_bound",
    "recovery_decision_bound",
    "provider_target_receipt_authenticated",
    "retention_intent_completed",
    "retained_receipt_cas_verified",
    "primary_checkout_disjointness_verified",
    "retention_topology_stable",
    "receipt_artifact_identity_stable",
    "persisted_effect_terminal_verified",
    "automatic_reexecution_allowed",
    "effect_start_authorized",
    "retention_write_authorized",
    "effect_terminalization_authorized",
    "canonical_entrypoint_registered",
    "gate_transition_authorized",
    "closed"
  ]
}
