{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/gate0-release-receipt-v1.schema.json",
  "title": "Gate0ReleaseReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "receipt_id",
    "verifier_id",
    "verifier_key_id",
    "source_revision",
    "source_tree_revision",
    "gate_report_sha256",
    "evidence_index_sha256",
    "trust_bundle_sha256",
    "requirements_sha256",
    "status",
    "verified_at",
    "signature_sha256",
    "provenance"
  ],
  "properties": {
    "contract_type": {
      "const": "daedalus-gate0-release-receipt/1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "$ref": "#/$defs/id"
    },
    "verifier_id": {
      "$ref": "#/$defs/id"
    },
    "verifier_key_id": {
      "$ref": "#/$defs/id"
    },
    "source_revision": {
      "$ref": "#/$defs/revision"
    },
    "source_tree_revision": {
      "$ref": "#/$defs/revision"
    },
    "gate_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "trust_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirements_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "passed"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "digestArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_revision",
        "created_at",
        "input_digests",
        "trace_id"
      ],
      "properties": {
        "origin": {
          "const": "gates.gate0-release-verifier"
        },
        "source_revision": {
          "$ref": "#/$defs/revision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_digests": {
          "$ref": "#/$defs/digestArray"
        },
        "trace_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
