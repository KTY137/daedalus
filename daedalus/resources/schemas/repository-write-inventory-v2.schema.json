{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/repository-write-inventory-v2.schema.json",
  "title": "Daedalus Gate 0 Repository Write Inventory v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "package_root",
    "scan_input_sha256",
    "files_scanned",
    "components",
    "surfaces",
    "surface_count",
    "blocker_count",
    "closed",
    "canonical_scanner_integrated",
    "inventory_generation",
    "scope",
    "inventory_only",
    "primary_checkout_target_proven",
    "blockers",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "daedalus-gate0-repository-write-inventory/2"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "package_root": {
      "const": "daedalus"
    },
    "scan_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_inventory_digest",
        "stdlib_delta_digest"
      ],
      "properties": {
        "base_inventory_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stdlib_delta_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "column",
          "origin",
          "kind",
          "callee",
          "operation",
          "blocking"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|//)"
            }
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "origin": {
            "enum": ["base_v1", "stdlib_delta_v1"]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "callee": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "surface_count": {
      "type": "integer",
      "minimum": 0
    },
    "blocker_count": {
      "type": "integer",
      "minimum": 0
    },
    "closed": {
      "type": "boolean"
    },
    "canonical_scanner_integrated": {
      "const": true
    },
    "inventory_generation": {
      "const": 2
    },
    "scope": {
      "const": "potential_repository_write_surface"
    },
    "inventory_only": {
      "const": true
    },
    "primary_checkout_target_proven": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "const": "unclassified-production-write-surfaces"
      },
      "maxItems": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
