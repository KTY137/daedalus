+        content_sha256=content,
+        locator=f"artifact-locator:sha256:{locator}",
+        built_at=built_at.isoformat(),
+        provenance=_provenance(
+            "tests.artifact",
+            content,
+            locator,
+            created_at=built_at,
+            revision=revision,
+        ),
+    )
+
