+def _classified_and_delta(tmp_path: Path, source: str):
+    """Return (classification, additive delta, base-inventory positions).
+
+    The delta is deliberately additive: a callsite the canonical inventory
+    already reports at the same position is not a false negative, so it is
+    suppressed.  Classification correctness therefore has to be observed on
+    the unsuppressed classifier, and the additive contract separately.
+    """
+
+    root = _repository(tmp_path, source)
+    resolved = root.resolve()
+    classified = _findings_for_file(
+        resolved,
+        (resolved / "daedalus" / "surface.py"),
+    )
+    delta = scan_repository_write_stdlib_delta(root, source_revision=REVISION)
+    base = scan_repository_write_surfaces(root, source_revision=REVISION)
+    return classified, delta.findings, _positions(base.callsites)
+
+
