+def _interpreter_path() -> Path:
+    """Return a readable path to the running interpreter binary.
+
+    On a Windows Store Python install ``sys.executable`` is a zero-byte
+    app-execution alias: it can be executed but never opened, so hashing it
+    raises ``OSError``. The real binary under ``sys.base_exec_prefix`` carries
+    the same interpreter identity and is readable. Venvs keep their own real
+    ``sys.executable``, so that stays the first choice and the fallback only
+    engages when the primary path genuinely cannot be read.
+    """
+
+    executable = Path(sys.executable)
+    base = Path(sys.base_exec_prefix)
+    candidates = (
+        executable,
+        base / executable.name,
+        base / "bin" / executable.name,
+    )
+    for candidate in candidates:
+        try:
+            with candidate.open("rb"):
+                return candidate
+        except OSError:
+            continue
+    raise OSError(f"no readable interpreter binary for {sys.executable!r}")
+
