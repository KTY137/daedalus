+def _cancel_process_tree(process: subprocess.Popen[str]) -> bool:
+    """Cancel a process and every descendant it spawned.
+
+    POSIX signals the new session's process group. Windows has no process
+    groups with these semantics, so the equivalent whole-tree cancellation is
+    ``taskkill /T``, which walks the recorded parent/child relationships.
+    """
+
+    if os.name == "posix":
+        os.killpg(process.pid, signal.SIGTERM)
+        return True
+    completed = subprocess.run(
+        ["taskkill", "/F", "/T", "/PID", str(process.pid)],
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    return completed.returncode == 0
+
