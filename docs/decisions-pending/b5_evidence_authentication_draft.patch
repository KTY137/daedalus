+# --------------------------------------------------------------------------- #
+# the grant receipt                                                            #
+# --------------------------------------------------------------------------- #
+#: Wire id of the record this module mints at grant time.  Deliberately NOT the
+#: same id as ``daedalus-effect-lease-receipt/1``: that one is the *chain
+#: evidence payload* verified by
+#: ``daedalus.gates.repository_write_effect_lease``, which names a terminal
+#: receipt that by definition does not exist yet when a lease is granted.  This
+#: record is the grant itself, and the gates layer builds the chain evidence
+#: from it once the execution it authorised has terminated.
+GRANT_RECEIPT_SCHEMA = "daedalus-effect-lease-grant-receipt/1"
+
+
+def lease_grant_record(
+    lease: "WaveOffloadLease",
+    *,
+    positions: int,
+    granted_at: datetime | None = None,
+) -> dict[str, Any]:
+    """The durable record of one granted wave lease, digest included.
+
+    Everything in it is read off the lease that was actually issued -- lease id
+    and digest, the effect set, the bounds (writable roots, egress endpoints,
+    tools, spend ceiling, concurrency, timeout), the kill-switch reference and
+    the exact generation the lease was bound to, the issuer key id, the registry
+    sha256, and the execution ids derived so far -- so the record cannot claim a
+    bound the lease does not carry.  ``positions`` is the wave width the grant
+    was requested for; the execution ids fill in as ``execution_for`` derives
+    them, and the record is minted again at that point if a caller wants them.
+
+    ``record_sha256`` binds the whole body, so a later reader can tell a
+    retained receipt from an edited one.
+    """
+
+    if type(lease) is not WaveOffloadLease:
+        raise TypeError("lease grant record requires a granted WaveOffloadLease")
+    if isinstance(positions, bool) or not isinstance(positions, int) or positions < 0:
+        raise ValueError("positions must be a non-negative integer")
+    body = dict(lease.receipt())
+    body["schema"] = GRANT_RECEIPT_SCHEMA
+    body["source_revision"] = lease.request.provenance.source_revision
+    body["mission_id"] = lease.request.mission_id
+    body["attempt_id"] = lease.request.attempt_id
+    body["request_sha256"] = lease.request.digest
+    body["positions"] = int(positions)
+    body["granted_at"] = _timestamp(granted_at or _utc_now())
+    body["record_sha256"] = _record_sha256(body)
+    return body
+
+
+def _record_sha256(body: Mapping[str, Any]) -> str:
+    from daedalus.spine.envelope import canonical_json
+
+    subject = {key: value for key, value in body.items() if key != "record_sha256"}
+    return hashlib.sha256(canonical_json(subject).encode("ascii")).hexdigest()
+
+
+def grant_receipt_root(repo_root: str | Path | None, source_revision: str) -> Path:
+    """Where grant receipts live: beside the ledger, never inside the checkout.
+
+    The candidate this lease authorises may hold a writable checkout.  Evidence
+    about a lease must not be reachable by the thing the lease bounds, which is
+    the isolation invariant, so the receipts sit under the same
+    checkout-external control root as the ledger they point into.
+    """
+
+    return control_root(repo_root) / "effect-lease-receipts" / str(source_revision)
+
+
+def emit_lease_grant_receipt(
+    lease: "WaveOffloadLease",
+    *,
+    repo_root: str | Path | None,
+    positions: int,
+) -> tuple[str, Path]:
+    """Persist one grant record content-addressed; return ``(sha256, path)``.
+
+    Content-addressed and published once: the same grant re-emitted is a no-op
+    rather than a rewrite, so a receipt can never be silently replaced with
+    different bytes under the same name.  The write goes through
+    ``daedalus.atomic.publish_bytes_once`` rather than an ``open`` here, because
+    this module is inside the scanned package and a new raw write surface in the
+    kernel is a new Gate-0 blocker.
+    """
+
+    from daedalus.atomic import publish_bytes_once
+    from daedalus.spine.envelope import canonical_json
+
+    record = lease_grant_record(lease, positions=positions)
+    digest = str(record["record_sha256"])
+    root = grant_receipt_root(repo_root, str(record["source_revision"]))
+    path = root / f"{digest}.json"
+    publish_bytes_once(path, canonical_json(record).encode("ascii"))
+    return digest, path
+
