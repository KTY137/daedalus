+# The three evidence kinds whose truth is a *receipt*, not a measurement this
+# module can repeat.  A ``source_anchor`` is re-derivable from the tree by
+# anyone (path, line, column, file digest) and a ``guard_contract`` names an
+# implementation the guard-structure verifier reads back out of the source; a
+# lease, a runtime-conformance and a disjointness receipt each assert something
+# that happened *outside* this projection and can only be authenticated by the
+# chain verifier that owns it.  Those are the kinds ``evidence_authenticated``
+# is about.
+AUTHENTICATED_EVIDENCE_KINDS = (
+    EvidenceKind.EFFECT_LEASE_RECEIPT,
+    EvidenceKind.PRIMARY_CHECKOUT_DISJOINTNESS_RECEIPT,
+    EvidenceKind.RUNTIME_CONFORMANCE_RECEIPT,
+)
+
+
+@dataclass(frozen=True)
+class SurfaceEvidenceAuthentication:
+    """One chain verifier's statement that it authenticated one evidence object.
+
+    This record is a *result*, never a declaration.  It cannot enter the
+    projection through ``project_classification_input`` -- the input schema has
+    no field for it -- so a JSON file can never authenticate anything.  It is
+    minted by the verifier that actually replayed the receipt (today:
+    ``daedalus.gates.repository_write_effect_lease.authenticate_surface_evidence``,
+    which mints only the kinds ``verify_repository_write_effect_leases``
+    genuinely replayed) and carries that verifier report's digest, so a reader
+    can trace which run authenticated what.
+
+    It binds ``(surface, kind, locator, evidence sha256)``: authenticating one
+    object at one surface says nothing about the same locator at another
+    surface, and a byte change to the evidence invalidates the record because
+    the sha256 no longer matches the retained binding.
+    """
+
+    surface_sha256: str
+    kind: EvidenceKind
+    locator: str
+    evidence_sha256: str
+    verifier_report_digest: str
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.kind, EvidenceKind):
+            raise ValueError("authentication kind must be typed")
+        if self.kind not in AUTHENTICATED_EVIDENCE_KINDS:
+            raise ValueError("authentication kind is not receipt evidence")
+        if not _SHA256.fullmatch(self.surface_sha256):
+            raise ValueError("authentication surface_sha256 must be lowercase 64-hex")
+        if not _SHA256.fullmatch(self.evidence_sha256):
+            raise ValueError("authentication evidence_sha256 must be lowercase 64-hex")
+        if not _SHA256.fullmatch(self.verifier_report_digest):
+            raise ValueError(
+                "authentication verifier_report_digest must be lowercase 64-hex"
+            )
+        if (
+            not isinstance(self.locator, str)
+            or not self.locator.strip()
+            or any(ch in self.locator for ch in "\r\n")
+        ):
+            raise ValueError("authentication locator must be a non-empty single line")
+
+    def sort_key(self) -> tuple[str, str, str, str, str]:
+        return (
+            self.surface_sha256,
+            self.kind.value,
+            self.locator,
+            self.evidence_sha256,
+            self.verifier_report_digest,
+        )
+
+    @property
+    def binding_key(self) -> tuple[str, str, str, str]:
+        return (self.surface_sha256, self.kind.value, self.locator, self.evidence_sha256)
+
+    def to_dict(self) -> dict[str, str]:
+        return {
+            "surface_sha256": self.surface_sha256,
+            "kind": self.kind.value,
+            "locator": self.locator,
+            "evidence_sha256": self.evidence_sha256,
+            "verifier_report_digest": self.verifier_report_digest,
+        }
+
+
+def required_authenticated_kinds(
+    row: SurfaceClassification,
+) -> tuple[EvidenceKind, ...]:
+    """The receipt kinds one classification must have verified to authenticate.
+
+    Derived from the row's own dispositions, so it is per surface and never a
+    module-wide set:
+
+    * an Effect-Lease receipt and a runtime-conformance receipt are required of
+      every row, because the flag's whole job is to say that the *effect* this
+      surface performs was leased and observed under a conforming runtime;
+    * a Primary-Checkout disjointness receipt is required in addition whenever
+      the row claims a disjoint target or a CENTRAL guard -- the two claims
+      that assert the write does not land in the primary checkout.  A row that
+      claims neither is still refused above for a different reason (it keeps
+      its ``candidate_blockers``), so this is not a way to authenticate a weaker
+      claim more cheaply.
+    """
+
+    if not isinstance(row, SurfaceClassification):
+        raise RepositoryWriteClassificationError(
+            "authentication subject must be a typed surface classification"
+        )
+    required = {
+        EvidenceKind.EFFECT_LEASE_RECEIPT,
+        EvidenceKind.RUNTIME_CONFORMANCE_RECEIPT,
+    }
+    if row.guard is GuardDisposition.CENTRAL or row.target in {
+        TargetDisposition.CHECKOUT_EXTERNAL,
+        TargetDisposition.NON_REPOSITORY,
+    }:
+        required.add(EvidenceKind.PRIMARY_CHECKOUT_DISJOINTNESS_RECEIPT)
+    return tuple(sorted(required, key=lambda kind: kind.value))
+
+
+def surface_evidence_authenticated(
+    row: SurfaceClassification,
+    authentications: Iterable[SurfaceEvidenceAuthentication],
+) -> bool:
+    """Decide, for exactly one surface, whether its receipt evidence is verified.
+
+    Three conditions, all of them per surface:
+
+    1. every kind :func:`required_authenticated_kinds` names for this row is
+       actually retained by the row -- a receipt nobody produced cannot be
+       authenticated by omitting it;
+    2. every retained binding of a required kind carries a matching
+       authentication record for *this* surface;
+    3. no retained receipt-kind binding is left unauthenticated, so a row cannot
+       become authenticated by carrying extra unverified receipts alongside the
+       verified ones.
+    """
+
+    if not isinstance(row, SurfaceClassification):
+        raise RepositoryWriteClassificationError(
+            "authentication subject must be a typed surface classification"
+        )
+    surface_sha256 = surface_binding_sha256(row.source_revision, row.surface)
+    verified = {
+        record.binding_key
+        for record in authentications
+        if record.surface_sha256 == surface_sha256
+    }
+    retained_by_kind: dict[EvidenceKind, list[EvidenceBinding]] = {}
+    for binding in row.evidence:
+        if binding.kind in AUTHENTICATED_EVIDENCE_KINDS:
+            retained_by_kind.setdefault(binding.kind, []).append(binding)
+    for kind in required_authenticated_kinds(row):
+        if not retained_by_kind.get(kind):
+            return False
+    for bindings in retained_by_kind.values():
+        for binding in bindings:
+            key = (
+                surface_sha256,
+                binding.kind.value,
+                binding.locator,
+                binding.sha256,
+            )
+            if key not in verified:
+                return False
+    return True
+
