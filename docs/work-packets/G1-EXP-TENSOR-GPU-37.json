  "finding": {
    "owner": "TypedRelationBlock._from_indexed",
    "problem": "An indexed entry with a negative or too-large row index could remain unconsumed while canonical CSR rows were materialized, silently dropping the entry instead of refusing a lossy projection. Python bool/float row aliases could also compare equal to integer row positions.",
    "risk": "Internal Fourfold/Tensor projection callers rely on this owner as a fail-closed canonical boundary after verified labels are mapped to indices. Silent omission is incompatible with exact, revision-bound projection semantics."
  },
  "implementation": {
