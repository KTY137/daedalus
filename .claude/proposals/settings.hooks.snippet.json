{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/daedalus/hooks/__main__.py\" pre_compact",
            "timeout": 15,
            "statusMessage": "Logging compaction to vault..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/proposals/hook_notification_toast.py\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
