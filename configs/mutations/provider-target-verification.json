        {
          "id": "skip-receipt-signature",
          "find": "    if not hmac.compare_digest(receipt.signature_sha256, expected_signature):\n",
          "replace": "    if False and not hmac.compare_digest(receipt.signature_sha256, expected_signature):\n"
