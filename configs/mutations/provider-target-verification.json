        },
        {
          "id": "trust-store-read-without-rehash",
          "find": "    if hashlib.sha256(payload).hexdigest() != entry.blob_sha256:\n",
          "replace": "    if False and hashlib.sha256(payload).hexdigest() != entry.blob_sha256:\n"
