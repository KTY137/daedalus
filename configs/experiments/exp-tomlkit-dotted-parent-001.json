    "task_id": "tomlkit-qualified-dotted-parent",
    "task_text": "Preserve the fully qualified parent path when a table is added below a container that originated from a parsed dotted key, without regressing valid TOML semantics or unaffected style.",
    "public_input": "[t]\na.b = 1\n",
    "public_mutation": "document[\"t\"][\"a\"][\"c\"] = {}",
    "required_qualified_header": "[t.a.c]",
    "forbidden_top_level_key": "a",
    "expected_semantic_value": {
      "t": {
        "a": {
          "b": 1,
          "c": {}
        }
      }
    },
    "hidden_case_categories": [
      "deeper-qualified-parent",
