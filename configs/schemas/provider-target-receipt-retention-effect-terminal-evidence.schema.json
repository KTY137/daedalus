{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/provider-target-receipt-retention-effect-terminal-evidence.schema.json",
  "title": "Provider Target Receipt Retention Effect Terminal Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "completed_evidence_sha256",
    "provider_target_receipt_sha256",
    "retention_execution_request_sha256",
    "retention_effect_lease_sha256",
    "start_receipt_sha256",
    "terminal_receipt_sha256",
    "terminal_output_set_sha256",
    "effect_execution_evidence_sha256",
    "effect_lease_store_identity_sha256",
    "effect_lease_store_path",
    "terminal_finished_at",
    "completed_retention_evidence_bound",
    "persisted_effect_terminal_verified",
    "exact_execution_request_bound",
    "exact_effect_lease_bound",
    "retained_receipt_output_bound",
    "effect_lease_store_stable",
    "automatic_reexecution_allowed",
    "effect_start_authorized",
    "retention_write_authorized",
    "effect_terminalization_authorized",
    "canonical_entrypoint_registered",
    "owner_approval_issued",
    "promotion_authorized",
    "gate_transition_authorized",
    "closed"
  ],
  "properties": {
    "schema": {
      "const": "daedalus-provider-target-receipt-retention-effect-terminal-evidence/1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "completed_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "provider_target_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "retention_execution_request_sha256": { "$ref": "#/$defs/sha256" },
    "retention_effect_lease_sha256": { "$ref": "#/$defs/sha256" },
    "start_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "terminal_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "terminal_output_set_sha256": { "$ref": "#/$defs/sha256" },
    "effect_execution_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "effect_lease_store_identity_sha256": { "$ref": "#/$defs/sha256" },
    "effect_lease_store_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "terminal_finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}\\+00:00$"
    },
    "completed_retention_evidence_bound": { "const": true },
    "persisted_effect_terminal_verified": { "const": true },
    "exact_execution_request_bound": { "const": true },
    "exact_effect_lease_bound": { "const": true },
    "retained_receipt_output_bound": { "const": true },
    "effect_lease_store_stable": { "const": true },
    "automatic_reexecution_allowed": { "const": false },
    "effect_start_authorized": { "const": false },
    "retention_write_authorized": { "const": false },
    "effect_terminalization_authorized": { "const": false },
    "canonical_entrypoint_registered": { "const": false },
    "owner_approval_issued": { "const": false },
    "promotion_authorized": { "const": false },
    "gate_transition_authorized": { "const": false },
    "closed": { "const": false }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
