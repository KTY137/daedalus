{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/offload-execution-plan-v1.schema.json",
  "title": "Daedalus OffloadExecutionPlan v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.$)[^\\\\\\u0000]+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "effectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "writable_paths",
        "egress_endpoints",
        "tools",
        "secret_refs",
        "max_cost_microusd",
        "max_concurrency",
        "timeout_s",
        "kill_switch_ref"
      ],
      "properties": {
        "read_only": {
          "const": false
        },
        "writable_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "egress_endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[1-9][0-9]{0,4}$"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "secret_refs": {
          "const": []
        },
        "max_cost_microusd": {
          "const": 0
        },
        "max_concurrency": {
          "const": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "kill_switch_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_revision",
        "created_at",
        "input_digests",
        "trace_id"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/identifier"
        },
        "source_revision": {
          "$ref": "#/$defs/revision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "contract_type",
    "contract_version",
    "plan_id",
    "spine_intent_id",
    "intent_sha256",
    "task_id",
    "task_sha256",
    "source_revision",
    "source_artifact_sha256",
    "worktree_id",
    "worktree_fingerprint_sha256",
    "provider_id",
    "model_id",
    "model_sha256",
    "provider_endpoint",
    "write_mode",
    "target_paths",
    "policy_decision_sha256",
    "availability_sha256",
    "routing_decision_sha256",
    "runtime_manifest_sha256",
    "runtime_conformance_sha256",
    "requested_effects",
    "effect_scope",
    "kill_switch_generation",
    "max_model_calls",
    "timeout_s",
    "max_cost_microusd",
    "tool_argv",
    "verifier_argv",
    "metrics_enabled",
    "drafts_enabled",
    "auto_mint_enabled",
    "provenance"
  ],
  "properties": {
    "contract_type": {
      "const": "daedalus.offload-execution-plan"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "spine_intent_id": {
      "type": "integer",
      "minimum": 1
    },
    "intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_revision": {
      "$ref": "#/$defs/revision"
    },
    "source_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "worktree_id": {
      "$ref": "#/$defs/identifier"
    },
    "worktree_fingerprint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_id": {
      "const": "ollama"
    },
    "model_id": {
      "$ref": "#/$defs/identifier"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider_endpoint": {
      "type": "string",
      "pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[1-9][0-9]{0,4}$"
    },
    "write_mode": {
      "const": "write"
    },
    "target_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "policy_decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "availability_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "routing_decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_conformance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "requested_effects": {
      "const": [
        "filesystem_write",
        "network_egress",
        "process_spawn",
        "spend"
      ]
    },
    "effect_scope": {
      "$ref": "#/$defs/effectScope"
    },
    "kill_switch_generation": {
      "type": "integer",
      "minimum": 0
    },
    "max_model_calls": {
      "const": 1
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1
    },
    "max_cost_microusd": {
      "const": 0
    },
    "tool_argv": {
      "$ref": "#/$defs/argv"
    },
    "verifier_argv": {
      "$ref": "#/$defs/argv"
    },
    "metrics_enabled": {
      "const": false
    },
    "drafts_enabled": {
      "const": false
    },
    "auto_mint_enabled": {
      "const": false
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  }
}
