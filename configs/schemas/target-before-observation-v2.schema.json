{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/target-before-observation-v2.schema.json",
  "title": "Daedalus TargetBeforeObservation v2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "portableTargetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {"pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[<>:\"|?*\\u0000-\\u001f])(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"},
        {"not": {"pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"}},
        {"not": {"pattern": "(?:^|/)[^/]*~[0-9]+(?:\\.[^/]*)?(?:/|$)"}}
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "source_revision", "created_at", "input_digests", "trace_id"],
      "properties": {
        "origin": {"$ref": "#/$defs/identifier"},
        "source_revision": {"$ref": "#/$defs/revision"},
        "created_at": {"type": "string", "format": "date-time"},
        "input_digests": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "trace_id": {"type": ["string", "null"]}
      }
    }
  },
  "required": [
    "contract_type", "contract_version", "workspace_attestation_sha256", "source_revision",
    "target_path", "target_kind", "content_sha256", "byte_length", "git_mode", "encoding",
    "file_identity_sha256", "parent_chain_sha256", "provenance", "filesystem_mode"
  ],
  "properties": {
    "contract_type": {"const": "daedalus.target-before-observation"},
    "contract_version": {"const": "2.0.0"},
    "workspace_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision": {"$ref": "#/$defs/revision"},
    "target_path": {"$ref": "#/$defs/portableTargetPath"},
    "target_kind": {"const": "existing-regular-utf8-file"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "byte_length": {"type": "integer", "minimum": 0},
    "git_mode": {"enum": ["100644", "100755"]},
    "encoding": {"const": "utf-8"},
    "file_identity_sha256": {"$ref": "#/$defs/sha256"},
    "parent_chain_sha256": {"$ref": "#/$defs/sha256"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "filesystem_mode": {"type": "integer", "minimum": 0, "maximum": 4095}
  }
}
