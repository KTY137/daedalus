{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/offload-execution-plan-v2.schema.json",
  "title": "Daedalus OffloadExecutionPlan v2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "portableTargetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "allOf": [
        {
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[<>:\"|?*\\u0000-\\u001f])(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
        },
        {
          "not": {
            "pattern": "(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)[^/]*~[0-9]+(?:\\.[^/]*)?(?:/|$)"
          }
        }
      ]
    },
    "loopbackEndpoint": {
      "type": "string",
      "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/identifier"
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "^[^\\u0000]+$"
      }
    },
    "effectScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "writable_paths",
        "egress_endpoints",
        "tools",
        "secret_refs",
        "max_cost_microusd",
        "max_concurrency",
        "timeout_s",
        "kill_switch_ref"
      ],
      "properties": {
        "read_only": {
          "const": false
        },
        "writable_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/portableTargetPath"
          }
        },
        "egress_endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/loopbackEndpoint"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "secret_refs": {
          "const": []
        },
        "max_cost_microusd": {
          "const": 0
        },
        "max_concurrency": {
          "const": 1
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "kill_switch_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_revision",
        "created_at",
        "input_digests",
        "trace_id"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/identifier"
        },
        "source_revision": {
          "$ref": "#/$defs/revision"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "contract_type",
    "contract_version",
    "spine_intent_id",
    "spine_intent_sha256",
    "mission_id",
    "attempt_id",
    "attempt_contract_sha256",
    "task_id",
    "task_sha256",
    "source_revision",
    "base_source_artifact_sha256",
    "workspace_id",
    "workspace_attestation_sha256",
    "workspace_observation_sha256",
    "target_path",
    "target_kind",
    "target_before_sha256",
    "target_before_size",
    "target_git_mode",
    "provider_id",
    "runtime_id",
    "provider_endpoint",
    "model_id",
    "expected_model_sha256",
    "prompt_template_sha256",
    "prompt_sha256",
    "response_schema_sha256",
    "ollama_request_sha256",
    "num_ctx",
    "num_predict",
    "seed",
    "temperature_milli",
    "keep_alive",
    "max_response_bytes",
    "max_metadata_calls",
    "max_model_calls",
    "attempt_policy_decision_sha256",
    "runtime_manifest_sha256",
    "runtime_conformance_sha256",
    "runtime_tool_binding_sha256",
    "verifier_argv",
    "verifier_timeout_s",
    "requested_effects",
    "effect_scope",
    "kill_switch_generation",
    "total_timeout_s",
    "max_cost_microusd",
    "provenance"
  ],
  "properties": {
    "contract_type": {
      "const": "daedalus.offload-execution-plan"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "spine_intent_id": {
      "type": "integer",
      "minimum": 1
    },
    "spine_intent_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mission_id": {
      "$ref": "#/$defs/identifier"
    },
    "attempt_id": {
      "$ref": "#/$defs/identifier"
    },
    "attempt_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_revision": {
      "$ref": "#/$defs/revision"
    },
    "base_source_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workspace_id": {
      "$ref": "#/$defs/identifier"
    },
    "workspace_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workspace_observation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_path": {
      "$ref": "#/$defs/portableTargetPath"
    },
    "target_kind": {
      "const": "existing-regular-utf8-file"
    },
    "target_before_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_before_size": {
      "type": "integer",
      "minimum": 0
    },
    "target_git_mode": {
      "enum": [
        "100644",
        "100755"
      ]
    },
    "provider_id": {
      "const": "ollama"
    },
    "runtime_id": {
      "const": "ollama_http"
    },
    "provider_endpoint": {
      "$ref": "#/$defs/loopbackEndpoint"
    },
    "model_id": {
      "$ref": "#/$defs/identifier"
    },
    "expected_model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_template_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ollama_request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "num_ctx": {
      "type": "integer",
      "minimum": 2048,
      "maximum": 131072
    },
    "num_predict": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "temperature_milli": {
      "const": 0
    },
    "keep_alive": {
      "const": "0"
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "max_metadata_calls": {
      "const": 1
    },
    "max_model_calls": {
      "const": 1
    },
    "attempt_policy_decision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_conformance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_tool_binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifier_argv": {
      "$ref": "#/$defs/argv"
    },
    "verifier_timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "requested_effects": {
      "const": [
        "filesystem_write",
        "network_egress",
        "process_spawn",
        "spend"
      ]
    },
    "effect_scope": {
      "$ref": "#/$defs/effectScope"
    },
    "kill_switch_generation": {
      "type": "integer",
      "minimum": 0
    },
    "total_timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "max_cost_microusd": {
      "const": 0
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  }
}
