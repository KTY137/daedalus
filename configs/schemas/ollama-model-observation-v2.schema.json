{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/ollama-model-observation-v2.schema.json",
  "title": "Daedalus OllamaModelObservation v2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "artifactLocator": {"type": "string", "pattern": "^artifact-locator:sha256:[0-9a-f]{64}$"},
    "loopbackEndpoint": {"type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "source_revision", "created_at", "input_digests", "trace_id"],
      "properties": {
        "origin": {"$ref": "#/$defs/identifier"},
        "source_revision": {"$ref": "#/$defs/revision"},
        "created_at": {"type": "string", "format": "date-time"},
        "input_digests": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "trace_id": {"type": ["string", "null"]}
      }
    }
  },
  "required": [
    "contract_type", "contract_version", "execution_request_sha256", "start_receipt_sha256",
    "execution_plan_sha256", "source_revision", "runtime_manifest_sha256", "provider_id",
    "runtime_id", "provider_endpoint", "metadata_request_sha256", "raw_response_sha256",
    "raw_response_size", "raw_response_artifact_locator", "selected_record_sha256", "model_id",
    "model_sha256", "model_size", "model_modified_at", "model_details_sha256",
    "provenance", "claim_receipt_sha256"
  ],
  "properties": {
    "contract_type": {"const": "daedalus.ollama-model-observation"},
    "contract_version": {"const": "2.0.0"},
    "execution_request_sha256": {"$ref": "#/$defs/sha256"},
    "start_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "execution_plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision": {"$ref": "#/$defs/revision"},
    "runtime_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "provider_id": {"const": "ollama"},
    "runtime_id": {"const": "ollama_http"},
    "provider_endpoint": {"$ref": "#/$defs/loopbackEndpoint"},
    "metadata_request_sha256": {"$ref": "#/$defs/sha256"},
    "raw_response_sha256": {"$ref": "#/$defs/sha256"},
    "raw_response_size": {"type": "integer", "minimum": 1},
    "raw_response_artifact_locator": {"$ref": "#/$defs/artifactLocator"},
    "selected_record_sha256": {"$ref": "#/$defs/sha256"},
    "model_id": {"$ref": "#/$defs/identifier"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "model_size": {"type": "integer", "minimum": 1},
    "model_modified_at": {"type": "string", "format": "date-time"},
    "model_details_sha256": {"$ref": "#/$defs/sha256"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "claim_receipt_sha256": {"$ref": "#/$defs/sha256"}
  }
}
