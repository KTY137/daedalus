{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/repository-write-effect-lease.schema.json",
  "title": "Daedalus Gate-0 Repository Write Effect-Lease Replay Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "classification_digest",
    "materialization_digest",
    "runtime_conformance_report_digest",
    "origin_attestation_digest",
    "production_classification_count",
    "effect_subject_count",
    "effect_binding_count",
    "effect_set_sha256",
    "records",
    "origin_authenticated",
    "source_anchor_semantics_verified",
    "guard_contract_structure_verified",
    "runtime_conformance_semantics_verified",
    "effect_lease_semantics_verified",
    "guard_contract_semantics_verified",
    "primary_checkout_disjointness_verified",
    "retirement_semantics_verified",
    "semantic_receipts_verified",
    "evidence_authenticated",
    "gate_report_bound",
    "closed",
    "scope",
    "blockers",
    "digest"
  ],
  "properties": {
    "schema": {
      "const": "daedalus-gate0-repository-write-effect-lease/1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "classification_digest": {
      "$ref": "#/$defs/sha256"
    },
    "materialization_digest": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_conformance_report_digest": {
      "$ref": "#/$defs/sha256"
    },
    "origin_attestation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "production_classification_count": {
      "type": "integer",
      "minimum": 1
    },
    "effect_subject_count": {
      "type": "integer",
      "minimum": 1
    },
    "effect_binding_count": {
      "type": "integer",
      "minimum": 1
    },
    "effect_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "origin_authenticated": {
      "const": true
    },
    "source_anchor_semantics_verified": {
      "const": true
    },
    "guard_contract_structure_verified": {
      "const": true
    },
    "runtime_conformance_semantics_verified": {
      "const": true
    },
    "effect_lease_semantics_verified": {
      "const": true
    },
    "guard_contract_semantics_verified": {
      "const": false
    },
    "primary_checkout_disjointness_verified": {
      "const": false
    },
    "retirement_semantics_verified": {
      "const": false
    },
    "semantic_receipts_verified": {
      "const": false
    },
    "evidence_authenticated": {
      "const": false
    },
    "gate_report_bound": {
      "const": false
    },
    "closed": {
      "const": false
    },
    "scope": {
      "const": "repository-write-effect-lease"
    },
    "blockers": {
      "const": [
        "gate-report-binding-missing",
        "guard-contract-behavioral-verification-missing",
        "primary-checkout-disjointness-semantic-verification-missing",
        "retirement-semantic-verification-missing"
      ]
    },
    "digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "nullableIdentifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_sha256",
        "locator",
        "entrypoint_id",
        "execution_id",
        "execution_request_sha256",
        "lease_sha256",
        "start_receipt_sha256",
        "terminal_receipt_sha256",
        "terminal_state",
        "runtime_bound",
        "runtime_id",
        "runtime_trust_record_sha256",
        "runtime_conformance_receipt_sha256",
        "replay_sha256"
      ],
      "properties": {
        "surface_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locator": {
          "type": "string",
          "pattern": "^cas:sha256:[0-9a-f]{64}$"
        },
        "entrypoint_id": {
          "$ref": "#/$defs/identifier"
        },
        "execution_id": {
          "$ref": "#/$defs/identifier"
        },
        "execution_request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lease_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "start_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_state": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "runtime_bound": {
          "type": "boolean"
        },
        "runtime_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "runtime_trust_record_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "runtime_conformance_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replay_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime_bound": {
                "const": true
              }
            },
            "required": [
              "runtime_bound"
            ]
          },
          "then": {
            "properties": {
              "runtime_id": {
                "$ref": "#/$defs/identifier"
              },
              "runtime_trust_record_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "else": {
            "properties": {
              "runtime_id": {
                "type": "null"
              },
              "runtime_trust_record_sha256": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
