{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.invalid/schemas/provider-target-receipt-retention-preflight.schema.json",
  "title": "Provider Target Receipt Retention Preflight Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_revision",
    "repository_head_receipt_sha256",
    "provider_target_receipt_sha256",
    "retention_inventory_sha256",
    "retention_inventory_source_sha256",
    "retention_inventory_source_size",
    "retention_inventory_surface_count",
    "retention_authority_sha256",
    "retention_subject_sha256",
    "retention_execution_request_sha256",
    "retention_effect_lease_sha256",
    "guard_contract",
    "guard_evidence",
    "event_store_scope_path",
    "receipt_cas_scope_path",
    "repository_head_reverified",
    "repository_head_stable_across_inventory",
    "retention_inventory_rebuilt",
    "retention_authority_authenticated",
    "guard_decision_allowed",
    "provider_execution_allowed",
    "persisted_effect_lease_verified",
    "retention_effect_started",
    "retention_write_performed",
    "canonical_entrypoint_registered",
    "gate_transition_authorized",
    "closed"
  ],
  "properties": {
    "schema": {
      "const": "daedalus-provider-target-receipt-retention-preflight/1"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository_head_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "provider_target_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "retention_inventory_sha256": { "$ref": "#/$defs/sha256" },
    "retention_inventory_source_sha256": { "$ref": "#/$defs/sha256" },
    "retention_inventory_source_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "retention_inventory_surface_count": {
      "type": "integer",
      "const": 7
    },
    "retention_authority_sha256": { "$ref": "#/$defs/sha256" },
    "retention_subject_sha256": { "$ref": "#/$defs/sha256" },
    "retention_execution_request_sha256": { "$ref": "#/$defs/sha256" },
    "retention_effect_lease_sha256": { "$ref": "#/$defs/sha256" },
    "guard_contract": {
      "const": "provider.target_receipt_retention"
    },
    "guard_evidence": {
      "type": "string",
      "pattern": "^authority_sha256=[0-9a-f]{64};subject_sha256=[0-9a-f]{64}$"
    },
    "event_store_scope_path": { "$ref": "#/$defs/repositoryPath" },
    "receipt_cas_scope_path": { "$ref": "#/$defs/repositoryPath" },
    "repository_head_reverified": { "const": true },
    "repository_head_stable_across_inventory": { "const": true },
    "retention_inventory_rebuilt": { "const": true },
    "retention_authority_authenticated": { "const": true },
    "guard_decision_allowed": { "const": true },
    "provider_execution_allowed": { "const": false },
    "persisted_effect_lease_verified": { "const": false },
    "retention_effect_started": { "const": false },
    "retention_write_performed": { "const": false },
    "canonical_entrypoint_registered": { "const": false },
    "gate_transition_authorized": { "const": false },
    "closed": { "const": false }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [".", ".."]
      },
      "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)[^\r\n]+$"
    }
  }
}
