{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daedalus.local/schemas/source-tree-manifest-v1.schema.json",
  "title": "Daedalus Source Tree Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "tree_id",
    "source_revision",
    "entries",
    "ignored_roots",
    "provenance"
  ],
  "properties": {
    "contract_type": {"const": "daedalus.source-tree-manifest"},
    "contract_version": {"const": "1.0.0"},
    "tree_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blob_sha256", "size", "executable"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "blob_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {"type": "integer", "minimum": 0},
          "executable": {"type": "boolean"}
        }
      }
    },
    "ignored_roots": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "allOf": [
        {"contains": {"const": ".git"}},
        {"contains": {"const": ".daedalus"}}
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_revision",
        "created_at",
        "input_digests",
        "trace_id"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "created_at": {"type": "string", "format": "date-time"},
        "input_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "trace_id": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
            }
          ]
        }
      }
    }
  }
}
